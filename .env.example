# microCMS
MICROCMS_SERVICE_DOMAIN=silmo-portfolio    # サービスドメイン
MICROCMS_API_KEY=xxx                       # GET API用キー
MICROCMS_WRITE_API_KEY=xxx                 # WRITE API用キー（お問い合わせ）

# Webhook認証
REVALIDATION_SECRET=xxx                    # microCMS Webhook用トークン

# プレビューモード
DRAFT_SECRET=xxx                           # Draft Mode認証用

# Google Analytics（任意）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX             # NEXT_PUBLIC_は公開可
